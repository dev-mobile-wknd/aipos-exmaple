# Salin jadi `local.properties` (di folder yang sama, di sebelah file ini) lalu isi.
#
# `aipos-sdk` memanggil OpenAI langsung dengan kunci ini — cukup untuk pengembangan
# dan demo. Untuk produksi pakai `AIPosSDK.Builder().llmProxyBaseUrl(...)` yang
# memanggil backend sendiri, supaya kunci tidak ikut terbundel di APK.
LLM_API_KEY=
